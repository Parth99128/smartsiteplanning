# Copy to .env and fill secrets. Never commit .env.
VITE_API_URL=http://localhost:8080
VITE_ML_URL=http://localhost:8000

# Postgres (required — compose fails fast without a password)
POSTGRES_DB=floodshield
POSTGRES_USER=floodshield
POSTGRES_PASSWORD=change-me-in-production

# Spring backend (uses POSTGRES_* above when running in compose)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/floodshield
SPRING_DATASOURCE_USERNAME=floodshield
SPRING_DATASOURCE_PASSWORD=change-me-in-production
ML_SERVICE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:4173

# ML service
MODEL_PATH=./models/rf_flood_model.pkl
MODEL_VERSION=rf-v2
LOG_LEVEL=INFO
